# ============================================================
# Environment: "sandbox" or "production"
# ============================================================
MPESA_ENV=sandbox

# ============================================================
# App/Consumer credentials — from your Daraja app
# (https://developer.safaricom.co.ke/MyApps)
# For production these come from your GO-LIVE app, not the
# sandbox test app.
# ============================================================
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# ============================================================
# STK Push (Lipa Na M-Pesa Online) — Paybill/Till shortcode
# ============================================================
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# Safaricom will only call back to a public HTTPS URL — your Render
# URL, not localhost.
MPESA_STK_CALLBACK_URL=https://YOUR-RENDER-URL.onrender.com/api/payments/deposit/callback

# ============================================================
# MongoDB — Atlas free tier works fine to start.
# https://www.mongodb.com/cloud/atlas/register -> Create a free
# cluster -> Database Access (create a user) -> Network Access
# (allow 0.0.0.0/0, or Render's static IPs if you set those up) ->
# Connect -> Drivers -> copy the connection string below.
# ============================================================
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/primevest?retryWrites=true&w=majority

# ============================================================
# Auth secrets — long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use TWO DIFFERENT values so a leaked user token can't be replayed
# as an admin token.
# ============================================================
JWT_SECRET=
ADMIN_JWT_SECRET=

# ============================================================
# Admin login — the ONLY account that can access /admin.
# Never put the plaintext password here. Generate the hash with:
#   node scripts/hash-password.js "your-chosen-password"
# and paste the output below. Change this password periodically.
# ============================================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=

# ============================================================
# Server / security
# ============================================================
PORT=10000
# Comma-separated list of origins allowed to call this API
# (your deployed frontend's URL, and http://localhost:xxxx for dev).
CORS_ORIGIN=http://localhost:5173
